# --- where the lab listens --------------------------------------------------
# LAB_BIND controls which host interface the three ports are published on.
#   127.0.0.1  -> loopback only; reach it from the Docker host itself, or via a
#                 reverse-proxy WAF running on the same host (upstream 127.0.0.1:808x).
#   <lab IP>   -> an ISOLATED interface (host-only adapter / lab VLAN, e.g.
#                 192.168.56.10) so a separate WAF/attacker box on that segment can
#                 reach it. Preferred when testing across machines.
#   0.0.0.0    -> every interface. Only on a truly isolated segment (no route to
#                 prod/internet, host firewall in place) — these are real outdated
#                 PHP builds; never leave them reachable from an untrusted network.
LAB_BIND=127.0.0.1

# PHP image tags for the PHP2Shell lab matrix. Swap these to test other versions;
# the verdict engine reads the live PHP_VERSION, so the demo stays correct.
#
# EOL   : 8.0 is end-of-life (unsupported) -> VULNERABLE, no upstream fix.
# OLD   : 8.3.10 is a supported branch but older than the fix (8.3.36) -> VULNERABLE.
# PATCH : 8.3-apache resolves to the current 8.3 patch (>= 8.3.36) -> PATCHED.
#         Pin to 8.3.36-apache explicitly once you've confirmed that tag is published.
EOL_TAG=8.0-apache
OLD_TAG=8.3.10-apache
PATCHED_TAG=8.3-apache
