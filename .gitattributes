# Force LF for files that must stay LF (shell scripts, Dockerfiles, container-run code).
* text=auto eol=lf
*.sh        text eol=lf
*.php       text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
.env        text eol=lf
